{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yeats33/iesim/blob/main/docs/schemas/carrier-presets-v1.schema.json",
  "title": "ieSIM carrier preset catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogVersion", "updatedAt", "carriers"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
    "updatedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "carriers": {
      "type": "array",
      "maxItems": 5000,
      "items": { "$ref": "#/$defs/carrier" }
    }
  },
  "$defs": {
    "carrier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "displayName", "operatorName", "countryCode", "countryName",
        "flag", "timeZoneId", "websiteUrl", "keepAlive"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,79}$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "operatorName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "countryCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "countryName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "flag": { "type": "string", "minLength": 1, "maxLength": 16 },
        "timeZoneId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "websiteUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "aliases": {
          "type": "array",
          "maxItems": 30,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "keepAlive": { "$ref": "#/$defs/keepAlive" }
      }
    },
    "keepAlive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cycleDays", "qualifyingActions"],
      "properties": {
        "cycleDays": { "type": "integer", "minimum": 1 },
        "qualifyingActions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "mobileData", "call", "sms", "topUp", "planPurchase",
              "renewal", "balanceChange", "other"
            ]
          }
        },
        "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "constraints": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/constraint" }
        },
        "presetId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "sourceLabel": { "type": "string", "minLength": 1, "maxLength": 160 },
        "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "sourceCheckedAt": { "type": "string", "format": "date-time", "pattern": "Z$" }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title", "details"],
      "properties": {
        "kind": { "enum": ["firstUse", "afterPlanExpiry", "paidRetention", "custom"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "details": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "withinDays": { "type": "integer", "minimum": 1 },
        "regions": {
          "type": "array",
          "maxItems": 30,
          "items": { "type": "string", "minLength": 1, "maxLength": 40 }
        }
      }
    }
  }
}
